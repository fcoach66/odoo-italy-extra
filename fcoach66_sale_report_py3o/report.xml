<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="fcoach66_sale_report_py3o.action_report_saleorder_odt" model="ir.actions.report">
	<field name="name">Preventivo / Ordine di Vendita py3o ODT</field>
    <field name="model">sale.order</field>
    <field name="report_name">fcoach66_sale_report_py3o.action_report_saleorder_odt</field>
    <field name="report_type">py3o</field>
    <field name="py3o_filetype">odt</field>
    <field name="module">fcoach66_sale_report_py3o</field>
    <field name="py3o_template_fallback">fcoach66_sale_order.odt</field>
    <field name="print_report_name">(object.state in ('draft', 'sent') and 'Quotation - %s' % (object.name)) or 'Order - %s' % (object.name)</field>
    <field name="binding_model_id" ref="sale.model_sale_order"/>
    <field name="binding_type">report</field>
</record>

